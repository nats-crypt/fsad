generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(PASSENGER)
  createdAt           DateTime             @default(now())
  employee            Employee?
  passenger           Passenger?
  paymentOrders       PaymentOrder[]
  passwordResetTokens PasswordResetToken[]
}

model Passenger {
  id          String    @id @default(cuid())
  userId      String    @unique
  fullName    String
  phone       String?
  dob         DateTime?
  nationality String?
  passportEnc String?
  address     String?
  preferences Json?
  bookings    Booking[]
  user        User      @relation(fields: [userId], references: [id])
}

model Employee {
  id          String           @id @default(cuid())
  userId      String?          @unique
  empCode     String           @unique
  fullName    String
  designation String
  dutyArea    String?
  salary      Decimal          @default(0)
  contact     String?
  attendance  Attendance[]
  crew        CrewAssignment[]
  dutyReports DutyReport[]
  user        User?            @relation(fields: [userId], references: [id])
}

model Airport {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  city       String
  country    String
  arrivals   Flight[] @relation("destination")
  departures Flight[] @relation("origin")
}

model Aircraft {
  id           String   @id @default(cuid())
  registration String   @unique
  model        String
  capacity     Int
  status       String   @default("ACTIVE")
  flights      Flight[]
}

model Flight {
  id            String           @id @default(cuid())
  flightNo      String
  originId      String
  destinationId String
  aircraftId    String
  departAt      DateTime
  arriveAt      DateTime
  baseFare      Decimal
  capacity      Int
  seatsBooked   Int              @default(0)
  status        FlightStatus     @default(SCHEDULED)
  bookings      Booking[]
  crew          CrewAssignment[]
  aircraft      Aircraft         @relation(fields: [aircraftId], references: [id])
  destination   Airport          @relation("destination", fields: [destinationId], references: [id])
  origin        Airport          @relation("origin", fields: [originId], references: [id])
  seats         Seat[]
  paymentOrders PaymentOrder[]
}

model Seat {
  id         String     @id @default(cuid())
  flightId   String
  seatNo     String
  cabinClass String     @default("ECONOMY")
  status     SeatStatus @default(AVAILABLE)
  booking    Booking?
  flight     Flight     @relation(fields: [flightId], references: [id])

  @@unique([flightId, seatNo])
}

model CrewAssignment {
  id         String   @id @default(cuid())
  flightId   String
  employeeId String
  role       String
  employee   Employee @relation(fields: [employeeId], references: [id])
  flight     Flight   @relation(fields: [flightId], references: [id])

  @@unique([flightId, employeeId])
}

model Booking {
  id             String        @id @default(cuid())
  pnr            String        @unique
  passengerId    String
  flightId       String
  seatId         String        @unique
  farePaid       Decimal
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  /// Name of the traveller for this seat (may differ from account holder for co-passengers)
  passengerName  String?
  /// Email of the traveller for this seat
  passengerEmail String?
  /// "ADULT" | "CHILD" (child = under 12)
  passengerType  String        @default("ADULT")
  flight         Flight        @relation(fields: [flightId], references: [id])
  passenger      Passenger     @relation(fields: [passengerId], references: [id])
  seat           Seat          @relation(fields: [seatId], references: [id])
  payment        Payment?
  ticket         Ticket?
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String   @unique
  orderId   String?
  paymentId String?
  cardLast4 String?
  amount    Decimal
  status    String   @default("PAID")
  method    String   @default("CARD")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model Ticket {
  id        String   @id @default(cuid())
  bookingId String   @unique
  issuedAt  DateTime @default(now())
  pdfKey    String?
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

/// Binds a payment-provider order to a specific flight+seat+amount+user.
/// Created when POST /api/payments/order is called; marked used=true when
/// POST /api/bookings consumes it. Prevents amount-tampering attacks.
model PaymentOrder {
  id        String   @id @default(cuid())
  orderId   String   @unique
  flightId  String
  seatNo    String
  /// JSON array of {seatNo,fare} for multi-passenger orders; legacy single-seat orders have seatNo only.
  seatsJson Json?
  /// Amount in rupees (server-computed from flight.baseFare).
  amount    Decimal
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  flight    Flight   @relation(fields: [flightId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model DutyReport {
  id         String    @id @default(cuid())
  employeeId String
  dutyArea   String
  startAt    DateTime
  endAt      DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  PASSENGER
  STAFF
  ADMIN
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum FlightStatus {
  SCHEDULED
  DEPARTED
  ARRIVED
  CANCELLED
}

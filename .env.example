# ======================================================================
# Horizon Airways — environment template. Copy to .env and fill in.
# NEVER commit a real .env (it is gitignored).
# ======================================================================

# --- Database (Neon Postgres for prod; local Docker Postgres for tests) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Object storage: S3-compatible (Neon Object Storage) ---
# Stores generated e-ticket PDFs; served to clients via presigned URLs.
AWS_ENDPOINT_URL_S3="https://<your-endpoint>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxxxxxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxxxxxx"
AWS_REGION="us-east-1"
S3_BUCKET="assets"

# --- Payments: Razorpay TEST mode (sandbox, no real money). If unset, the
#     app falls back to a mock gateway (Luhn validation only). ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- Frontend origin for CORS ---
CLIENT_URL="http://localhost:5173"

# --- LLM-backed AI mode (OpenAI-compatible endpoint, e.g. NVIDIA NIM).
#     If LLM_API_KEY is set the AI features call this model; otherwise they
#     fall back to fully offline heuristics. ---
LLM_API_KEY="nvapi-xxxxxxxx"
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_MODEL="moonshotai/kimi-k3.1-pro"
